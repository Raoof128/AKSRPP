{
  "dashboard": {
    "title": "Kubernetes Security Posture",
    "panels": [
      {
        "title": "Policy Violations (Last 24h)",
        "targets": [
          {
            "expr": "sum(increase(gatekeeper_violations_total[24h])) by (constraint)"
          }
        ],
        "type": "graph"
      },
      {
        "title": "Runtime Threats by Severity",
        "targets": [
          {
            "expr": "sum by(priority) (security_operator_alerts_received_total)"
          }
        ],
        "type": "piechart"
      },
      {
        "title": "Mean Time to Remediation",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(security_operator_remediation_duration_seconds_bucket[1h]))"
          }
        ],
        "type": "stat"
      },
      {
        "title": "Attack Surface Score",
        "targets": [
          {
            "expr": "100 - (sum(rate(policy_compliant_deployments[1h])) / sum(rate(total_deployments[1h])) * 100)"
          }
        ],
        "type": "gauge"
      }
    ],
    "templating": {
      "list": [
        {
          "name": "namespace",
          "type": "query",
          "query": "label_values(kube_pod_info, namespace)"
        }
      ]
    }
  }
}
